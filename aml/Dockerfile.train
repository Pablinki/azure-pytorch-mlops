# Training image: dependencies only. The job installs the code snapshot on top (`pip install --no-deps .`).
FROM mcr.microsoft.com/azureml/openmpi4.1.0-ubuntu22.04

# The base image ships a conda Python; textclf needs >= 3.10.
RUN python --version && python -c "import sys; assert sys.version_info >= (3, 10), sys.version"

WORKDIR /tmp/build
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir ".[train]"
